# LLM provider configuration ("groq", "ollama", or "gemini")
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
ALLOW_PROVIDER_SWITCH=false

# API keys (store in Azure Key Vault / Container App Secrets / App Service Settings)
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Endpoint URLs (optional overrides)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# OLLAMA_API_URL=http://localhost:11434/v1/chat/completions

# Storage & logging (point to persistent mount on Azure, e.g. /app/data or /home/data)
CHROMA_DB_DIR=./chroma_db
LLM_LOG_PATH=./llm_calls.jsonl
ENABLE_FILE_LOGGING=true
LOG_REDACT_CONTENT=true

# Security & resource limits
MAX_PDF_MB=25
MAX_PROMPT_CHARS=8000
MAX_CONTEXT_CHARS=15000
MAX_CHAT_HISTORY=20
MAX_TOOL_ROUNDS=5
REQUEST_TIMEOUT_SEC=60
DEFAULT_TIMEZONE=Asia/Karachi
RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
